{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {

    "Routes": {

      "librosRoute": {
        "ClusterId": "librosCluster",
        "Match": {
          "Path": "/api/Libros/{**catch-all}"
        }
      },

      "inventariosRoute": {
        "ClusterId": "inventariosCluster",
        "Match": {
          "Path": "/api/Inventarios/{**catch-all}"
        }
      },

      "categoriasRoute": {
        "ClusterId": "categoriasCluster",
        "Match": {
          "Path": "/api/Categorias/{**catch-all}"
        }
      },

      "vehiculosRoute": {
        "ClusterId": "vehiculosCluster",
        "Match": {
          "Path": "/api/Vehiculo/{**catch-all}"
        }
      }

    },

    "Clusters": {

      "librosCluster": {
        "Destinations": {
          "librosDestination": {
            "Address": "http://localhost:5000/"
          }
        }
      },

      "inventariosCluster": {
        "Destinations": {
          "inventariosDestination": {
            "Address": "http://localhost:5234/"
          }
        }
      },

      "categoriasCluster": {
        "Destinations": {
          "categoriasDestination": {
            "Address": "http://localhost:5110/"
          }
        }
      },

      "vehiculosCluster": {
        "Destinations": {
          "vehiculosDestination": {
            "Address": "http://localhost:5156/"
          }
        }
      }

    }
  }
}